{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sister-fund",
  "account_id": "4ab5971904c0bf65b7248cdf1ade744d",
  "compatibility_date": "2026-08-15",
  "assets": {
    // 纯静态 SPA：没有 Worker 脚本，所有路由都回落到 index.html
